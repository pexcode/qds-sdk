{
  "name": "@pexcode/qds-sdk",
  "version": "3.1.2",
  "description": "This is a library published under Pexcode to help users and developers to use QuickDeliverySystem API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "./dist/index.mjs",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Mussab Muhaimeed",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "swagger-dev": "npx openapi-typescript-codegen --input http://localhost:2500/swagger.json --output src/api --client axios",
    "build-tsup": "tsup src/index.ts --format cjs,esm --dts --clean --minify"
  },
  "devDependencies": {
    "openapi-typescript-codegen": "^0.29.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "axios": "^1.7.7"
  }
}